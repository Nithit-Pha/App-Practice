# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored — never commit secrets.

# Port the API listens on
PORT=5000

# Origin allowed by CORS (the URL where the React app runs)
ALLOWED_ORIGIN=http://localhost:5173

# JWT signing secret — REQUIRED. Must be a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long an issued JWT stays valid (e.g. "15m", "1h", "1d")
JWT_EXPIRES_IN=1h

# bcrypt rounds. Higher = slower hashing = more brute-force resistant.
# 10–12 is typical. Each +1 doubles the cost.
BCRYPT_ROUNDS=10
