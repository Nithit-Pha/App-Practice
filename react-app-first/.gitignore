# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Secrets & credentials ----------
# Catch every flavour of .env, but keep the committed example file.
.env
.env.*
!.env.example
!.env.example.*

# Anything that smells like a credential
secrets/
*.secret
*.secrets

# Private keys, certs, key material
*.pem
*.key
*.crt
*.cer
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.pgp
*.asc
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub

# ---------- Local databases (in case any escape /database) ----------
*.sqlite
*.sqlite3
*.db
*-journal
*.db-journal
*.db-wal
*.db-shm

# Database dumps (e.g. `sqlite3 app.db .dump > x.dump`).
# We deliberately do NOT use `*.sql` because schema.sql is committed.
*.dump
*.dump.sql
*.sql.bak
dump.sql
backup.sql

# ---------- Build / cache / coverage ----------
coverage/
.nyc_output/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.cache/
.parcel-cache/
.turbo/

# ---------- OS metadata ----------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Backups & swap files ----------
*.bak
*.backup
*.orig
*~

# ---------- Process / temp files ----------
*.pid
*.pid.lock
*.seed
pids/
tmp/
temp/
.tmp/

# ---------- Security scan output ----------
# ZAP, nuclei, semgrep, npm audit dumps — never commit, sometimes contain
# example payloads that look like secrets to scanners.
zap-report.*
zap_*.html
zap_*.json
.zap/
security-report.*
audit-report.*
semgrep-report.*

# ---------- Test fixtures with secrets ----------
# Anything generated by integration tests against real services.
fixtures/secrets/
test-creds.json
.test-tmp/

# ---------- Local history / AI assistants ----------
.history/
.aider*
.cursorignore
.continue/

# ---------- Claude Code workspace (settings, worktrees, etc.) ----------
.claude/

